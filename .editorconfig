# EditorConfig —— 统一编辑器行为，与 gofmt / golangci-lint 保持一致
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go：gofmt 规范为 Tab 缩进
[*.go]
indent_style = tab
indent_size = 4

# Makefile：recipe 必须以 Tab 开头
[Makefile]
indent_style = tab
indent_size = 4

# YAML / JSON：空格缩进
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown：保留行尾双空格（硬换行）
[*.md]
trim_trailing_whitespace = false

# SQL 迁移：空格缩进
[*.sql]
indent_style = space
indent_size = 4

# 前端（M8 起生效）
[*.{js,ts,tsx,jsx,css,html}]
indent_style = space
indent_size = 2
