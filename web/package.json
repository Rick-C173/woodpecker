{
  "name": "woodpecker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "npm run gen:api:convert && npm run gen:api:types",
    "gen:api:convert": "swagger2openapi ../docs/swagger.json -o src/api/openapi.json",
    "gen:api:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.13.4",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.2.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.15.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.5.0",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
