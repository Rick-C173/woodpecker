# systemd 服务单元模板（scripts/deploy/linux/install.sh 会替换占位符后写入
# /etc/systemd/system/woodpecker.service）。
# 默认单进程跑 api+worker（--mode=all）；拆分部署时复制两份改 mode=api / mode=worker
# 并用不同 Description/WorkingDirectory（共享同一 uploads 目录）。

[Unit]
Description=Woodpecker AI knowledge base (api+worker)
Documentation=https://github.com/Rick-C173/woodpecker
After=network-online.target
Wants=network-online.target
# PostgreSQL/Redis 在本机时打开以下两行（远程部署无需）：
#After=postgresql.service redis.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=-__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/woodpecker --mode=all
Restart=on-failure
RestartSec=3
# 上传 50x5MB 与 SSE 长连接：不设超时限制由应用层自理
LimitNOFILE=65535

# 安全加固：数据目录与安装目录可写，其余只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__INSTALL_DIR__ __DATA_DIR__

[Install]
WantedBy=multi-user.target
