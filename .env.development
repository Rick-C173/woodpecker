# Woodpecker 开发环境配置（入库模板，无敏感值）。
# 加载机制（internal/config）：先读 .env（公共兜底，可含 APP_ENV），
# 再按 APP_ENV 覆盖加载 .env.{APP_ENV}——本文件即 APP_ENV=development 时的专属配置，
# 其中的值会覆盖 .env 里的同名项。
# 为什么入库：全部值均为本地开发默认（localhost 连接串、相对路径、密钥留空），
# 不含任何敏感信息；入库让新机器/协作者 clone 后零配置即可起服务。
# 密钥留空：development 下代码回落占位密钥并打警告；生产必须用 .env 显式注入。

# ---- 运行环境 ----
APP_ENV=development

# ---- 核心 ----
APP_PORT=8080
# 本地 PostgreSQL 17（pgvector 扩展需预装；扩展安装见 md/运行手册.md）
DATABASE_URL=postgres://woodpecker:woodpecker@127.0.0.1:5432/woodpecker?sslmode=disable
REDIS_ADDR=127.0.0.1:6379

# ---- 密钥（开发留空 → 代码回落占位密钥并打警告；生产严禁留空）----
JWT_SECRET=
# AES-256-GCM 密钥（≥32 字节；M3 起用于模型 API Key 加密）
ENCRYPTION_KEY=

# ---- 日志 ----
LOG_LEVEL=debug
# LOG_TO_FILE=true 时控制台与文件双写，目录自动创建
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# ---- API ----
CORS_ORIGINS=*
# JWT 有效期（小时；token_version 变更/改密即失效）
JWT_TTL_HOURS=24
# 登录态全局窗口限流 req/min/用户，<=0 关闭
RATE_LIMIT_PER_MIN=100
# 启动 banner 开关
BANNER_ENABLED=true

# ---- 密码策略（PRD FR-01）----
PASSWORD_MIN_LEN=8
PASSWORD_LOCK_THRESHOLD=5
PASSWORD_LOCK_MINUTES=10
INITIAL_PASSWORD_LEN=12

# ---- 数据库连接池（数据库设计 §6）----
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# ---- 摄取 ----
# 上传落地目录：相对 cwd（仓库根），Windows/macOS/Linux 通用；worker 与 API 进程需一致
UPLOAD_DIR=./data/uploads
# Git HTTPS token 认证的用户名位（密码位固定放 token）：GitLab PAT 必须 oauth2；
# GitHub 可用 x-access-token；Bitbucket 用 x-token-auth
GIT_TOKEN_USERNAME=oauth2
# Git 定时同步扫描间隔（分钟，M14；<=0 关闭）
GIT_AUTO_SYNC_MINUTES=30
# SSH 私有仓库主机指纹校验（开发可不配，生产必须）
# SSH_KNOWN_HOSTS=

# ---- 邀请（FR-16）----
# 站点外部访问地址（邀请链接前缀，如 http://localhost:8080）；空=邀请降级为仅邮件路径
APP_BASE_URL=

# ---- worker（多实例部署才需要关注）----
# 缺省取主机名；同主机多实例必须显式唯一
# WORKER_ID=
# 僵尸任务心跳超时阈值（分钟，缺省 5；须 > 心跳间隔 30s 的 5 倍）
# WORKER_ZOMBIE_TIMEOUT_MINUTES=5
# 周期性僵尸回收间隔（分钟，缺省 2，<=0 关闭）
# WORKER_ZOMBIE_SWEEP_MINUTES=2
