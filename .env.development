# Woodpecker 开发环境配置（入库模板，无敏感值）。
# 加载机制（internal/config）：先读 .env（公共兜底，可含 APP_ENV），
# 再按 APP_ENV 覆盖加载 .env.{APP_ENV}——本文件即 APP_ENV=development 时的专属配置。
# 密钥留空：development 下代码回落占位密钥并打警告；生产必须用 .env 显式注入。

APP_ENV=development
# 本地 PostgreSQL 17（pgvector 扩展需预装；扩展安装见 md/运行手册.md）
DATABASE_URL=postgres://woodpecker:woodpecker@127.0.0.1:5432/woodpecker?sslmode=disable
REDIS_ADDR=127.0.0.1:6379

# 上传落地目录：相对 cwd（仓库根），Windows/macOS/Linux 通用
UPLOAD_DIR=./data/uploads

LOG_LEVEL=debug
CORS_ORIGINS=*
