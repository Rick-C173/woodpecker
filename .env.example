# 复制为 .env 后按需修改；开发默认值见 internal/config/config.go
# 默认连本机原生服务：PostgreSQL 5432（postgresql-zj）/ Redis 6379
# Docker 备用栈见 docker-compose.dev.yml（映射到 5433/6380，与本机服务不冲突）

# 运行环境（development / production）
# production 时：JWT_SECRET 与 ENCRYPTION_KEY 必须显式注入（缺失或弱密钥直接拒绝启动），
# 生产部署务必改为 production，否则缺密钥只会打警告并用开发占位密钥启动
APP_ENV=development

APP_PORT=8080
DATABASE_URL=postgres://woodpecker:woodpecker@127.0.0.1:5432/woodpecker?sslmode=disable
REDIS_ADDR=127.0.0.1:6379

# 生产必须显式注入（开发不设时用占位值并打警告）
JWT_SECRET=
# AES-256-GCM 密钥（32 字节；M3 起用于模型 API Key 加密）
ENCRYPTION_KEY=

LOG_LEVEL=info
CORS_ORIGINS=*
# JWT 有效期（小时；token_version 变更/改密即失效）
JWT_TTL_HOURS=24

# 启动展示
# 启动 banner 开关（true/false）
BANNER_ENABLED=true

# 日志输出（LOG_TO_FILE=true 时控制台与文件双写，目录自动创建）
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# 限流（API 设计 §1）：登录态全局窗口限流 req/min/用户，<=0 关闭
RATE_LIMIT_PER_MIN=100

# 密码策略（PRD FR-01）
PASSWORD_MIN_LEN=8
PASSWORD_LOCK_THRESHOLD=5
PASSWORD_LOCK_MINUTES=10
INITIAL_PASSWORD_LEN=12

# 数据库连接池（数据库设计 §6）
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# 摄取（M4）：上传文件落地目录（worker 与 API 进程需一致）
UPLOAD_DIR=data/uploads

# 摄取 worker 标识（审计 P1-8）：任务开始处理时写入 ingest_tasks.worker_id，
# 重启恢复只清理本标识的残留任务（旧实现是无条件全库 UPDATE → 多实例互相杀掉对方任务）。
# 缺省取主机名。**多实例部署必须各自配置唯一值**（同主机多容器 hostname 会撞车，
# 例如 k8s 同 Pod 多容器、docker-compose 同网络别名场景），否则仍会互杀。
# WORKER_ID=worker-1

# Git HTTPS token 认证的用户名位（密码位固定放 token）
# GitLab PAT 必须 oauth2；GitHub 可用 x-access-token；Bitbucket 用 x-token-auth
GIT_TOKEN_USERNAME=oauth2

# SSH 私有仓库：主机指纹校验优先读 ~/.ssh/known_hosts 与 /etc/ssh/ssh_known_hosts，
# 也可用 SSH_KNOWN_HOSTS 指定（冒号分隔多个路径）。两者都不存在时会退化为主机指纹不校验并打警告，
# 生产环境必须配置 known_hosts。
# SSH_KNOWN_HOSTS=/etc/ssh/ssh_known_hosts
