# Woodpecker 生产环境变量模板。复制为仓库根目录 .env 后按需修改。
# 全部 CHANGE_ME 必须替换；生成密钥：
#   JWT_SECRET:     openssl rand -base64 48
#   ENCRYPTION_KEY: openssl rand -base64 32
# 加载机制（internal/config）：先读 .env，再按 APP_ENV 覆盖加载 .env.production（存在时）。
# APP_ENV=production 时缺失/过弱密钥将拒绝启动（internal/config 校验）。

# ---- 运行环境 ----
APP_ENV=production

# ---- compose 编排 ----
POSTGRES_USER=woodpecker
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=woodpecker
WEB_PORT=80
WORKER_ID=worker-1
# WORKER_REPLICAS=1   # 多副本部署时每个 worker 必须唯一 WORKER_ID

# ---- 应用核心 ----
APP_PORT=8080
LOG_LEVEL=info
LOG_TO_FILE=false
BANNER_ENABLED=false
RATE_LIMIT_PER_MIN=100
CORS_ORIGINS=*   # 同源部署（nginx 反代）无需跨域；确有跨域前端时列出明确 origin

# ---- 密钥（生产必填）----
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ---- 摄取 ----
UPLOAD_DIR=/data/uploads
PASSWORD_MIN_LEN=8
PASSWORD_LOCK_THRESHOLD=5
PASSWORD_LOCK_MINUTES=10
INITIAL_PASSWORD_LEN=12

# ---- Git 接入 ----
# HTTPS token 认证的用户名位（密码位固定放 token）：GitLab PAT 必须 oauth2；
# GitHub 可用 x-access-token；Bitbucket 用 x-token-auth
GIT_TOKEN_USERNAME=oauth2
# Git 定时同步扫描间隔（分钟，M14）：worker 周期扫描 auto_sync 的 git 文档并入队增量 sync。
# 0 或负数关闭定时同步（webhook 触发不受影响）
GIT_AUTO_SYNC_MINUTES=30
# SSH 私有仓库主机指纹校验：优先读 ~/.ssh/known_hosts 与 /etc/ssh/ssh_known_hosts，
# 也可指定路径（冒号分隔）。生产必须配置，否则退化为主机指纹不校验并打警告。
# SSH_KNOWN_HOSTS=/data/known_hosts
